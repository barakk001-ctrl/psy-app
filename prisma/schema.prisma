// Psychology Practice Management — v1 schema
// Single-tenant per User row, but designed so multi-tenant is a non-breaking change later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth & practice owner
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  hashedPassword  String?

  // Used on invoice/receipt headers
  businessName    String?
  businessId      String?   // ת.ז / ע.מ / ח.פ
  address         String?
  phone           String?
  // Logo or photo shown in the app header (a small data: URL resized in the
  // browser, so no file storage is needed)
  logoUrl         String?
  // Show the logo at the top of the app's document preview and draft PDFs
  logoOnDocuments Boolean   @default(false)

  // More business details for documents (Settings → הגדרות עסק). `address`
  // above and `phone` are the document's address and phone; docEmail is the
  // address printed on documents (not the sign-in email).
  occupation          String?   // "עיסוק / מקצוע"
  businessDescription String?   // one line under the name on documents
  docEmail            String?
  website             String?
  // "פרטי העסק באנגלית", for documents in English (later)
  businessNameEn      String?
  addressEn           String?
  descriptionEn       String?

  // How documents look (Settings → הגדרות מסמכים; src/lib/document-look.ts)
  // A signature image shown at the bottom of documents: a small PNG/JPEG data:
  // URL, scaled in the browser and checked on the server, like the logo
  signatureUrl     String?
  docTemplate      String   @default("classic")
  docColor         String   @default("sage")
  // The email to the client with a document (null = the default text); used
  // once the app issues documents
  docEmailSubject  String?
  docEmailBody     String?
  // The number the next document of each type will get, once the app issues
  // documents ("המספר של המסמך הבא"). Never moves backwards after issuing.
  docNextTaxInvoice        Int @default(1)
  docNextTaxInvoiceReceipt Int @default(1)
  docNextReceipt           Int @default(1)
  docNextCreditNote        Int @default(1)
  // Name shown under "מרפאה אישית" in the header, so the app reads as theirs
  brandName       String?

  // Defaults
  defaultRate     Decimal?  @db.Decimal(10, 2)
  currency        String    @default("ILS")
  timezone        String    @default("Asia/Jerusalem")
  // How long a meeting runs unless the form says otherwise. 50 is the common
  // "therapeutic hour", but practices differ — 45 and 30 are both normal.
  defaultSessionMinutes Int  @default(50)
  // Calendar: show Israeli holidays in the day cells (the checkbox above the calendar)
  showHolidays    Boolean   @default(false)
  // עוסק מורשה = true (prices include VAT, show breakdown); עוסק פטור = false
  vatLiable       Boolean   @default(false)

  // For sequential invoice numbering
  nextInvoiceNumber Int     @default(1)

  // First-run setup wizard (/setup, src/lib/onboarding.ts). Null completedAt =
  // not finished; pausedAt = chose "לסיים מאוחר יותר" (no forced redirect).
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  onboardingPausedAt    DateTime?

  // Data-holding agreement click-acceptance (version from src/lib/agreement.ts;
  // a version bump triggers the re-acceptance banner on the dashboard)
  agreementVersion    String?
  agreementAcceptedAt DateTime?
  // Terms of service accepted at sign-up (version from src/lib/terms.ts). Null
  // for accounts that signed up before this was asked; nobody is asked again.
  termsVersion        String?
  termsAcceptedAt     DateTime?

  // Private ICS calendar feed (Google Calendar subscribe-by-URL).
  // calendarNameMode: FIRST | FULL | NONE — how client names appear in events.
  calendarToken    String? @unique
  calendarNameMode String  @default("FIRST")

  // Subscription: 30-day trial from registration, then a paid plan extended
  // manually by the operator (payments happen outside the app for now).
  // Expired accounts drop to read-only — data is never locked away.
  trialEndsAt        DateTime?
  subscriptionPlan   String?   // MONTHLY | YEARLY
  subscriptionEndsAt DateTime?
  subscriptionExempt Boolean   @default(false)
  isAdmin            Boolean   @default(false)

  // Token for the inbound message API (/api/inbox) — iOS Shortcuts etc.
  /// The public appointment-request link (/request/<token>) — shared with clients
  inboxToken       String?   @unique
  /// The private inbox API (/api/inbox) for shortcuts/automations — never the same as inboxToken
  inboxApiToken    String?   @unique

  // Automatic sign-out after this many minutes without activity (15/30/60,
  // Settings → ניתוק אוטומטי; rules in src/lib/idle-timeout.ts)
  idleTimeoutMinutes Int   @default(30)

  // Two-factor auth (TOTP) — secret encrypted at app layer; enabled only
  // after the first code is verified during enrollment
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  totpBackupCodes  String?   // JSON array of sha256 hashes; entries removed on use

  // Password reset — token stored as sha256, valid until expiry, single use
  resetToken       String?
  resetTokenExpiry DateTime?

  // Email verification (src/lib/email-verification.ts). Null verifiedAt = an
  // email/password sign-up that hasn't confirmed its address: no session is
  // issued until it does. The token is stored as sha256, single use, 24 hours.
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?   @unique
  emailVerifyExpiresAt DateTime?

  // The invite code this account signed up with, if any (not a relation: see InviteCode)
  inviteCodeId         String?

  // Sign-in with a one-time code ("כניסה עם קוד חד פעמי"; rules in
  // src/lib/login-code.ts). One live code per account: HMAC-hashed, single
  // use, 10 minutes, at most 5 wrong tries. A new request replaces it.
  loginCodeHash      String?
  loginCodeExpiresAt DateTime?
  loginCodeAttempts  Int       @default(0)
  // Mobile number for codes by SMS: not used until an SMS provider is set up
  // (src/lib/login-code-channel.ts). Separate from `phone`, which is the
  // business number printed on invoices.
  loginPhone         String?

  // Full account export (src/lib/account-export.ts): the re-check in Settings
  // leaves a one-time grant here (sha256, 5 minutes) that the download spends.
  exportGrantHash      String?
  exportGrantExpiresAt DateTime?

  // Account closure (src/lib/account-closure.ts): set only by the owner in
  // Settings, cleared by restoring. After purgeAfter the hourly job deletes the
  // account for good. Subscription expiry never sets these.
  closedAt   DateTime?
  purgeAfter DateTime?

  // The type "מסמך חדש" starts on: 400 קבלה, 320 חשבונית מס/קבלה, 305 חשבונית
  // מס (Settings → ברירות מחדל למסמכים). The column keeps its old name.
  defaultDocType   Int      @default(400) @map("morningDocType")
  // What each new document's settings bar starts on (Settings → ברירות מחדל למסמכים)
  docCurrency      String   @default("ILS")
  docLang          String   @default("he")
  docVatType       Int      @default(0)
  docRounding      Boolean  @default(false)

  clients         Client[]
  sessions        Session[]
  invoices        Invoice[]
  reminderJobs    ReminderJob[]
  morningDocuments MorningDocument[]
  expenses         Expense[]
  inboxMessages    InboxMessage[]
  todos            Todo[]
  meetingTypes     MeetingType[]
  sessionFiles     SessionFile[]
  clientDocuments  ClientDocument[]
  supportRequests  SupportRequest[]
  waitlistEntries  WaitlistEntry[]
  subscriptionNotices SubscriptionNotice[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([purgeAfter])
}

// One row per trial/subscription email to an account: taken before sending, so
// nothing is sent twice (src/lib/subscription-notices.ts). periodEnd is the end
// the email was about, so a renewed period gets its own notices.
model SubscriptionNotice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     String    // DAYS_7 | DAY_1 | ENDED
  periodEnd DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, stage, periodEnd])
}

// ─────────────────────────────────────────────────────────────
// Clients (patients)
// ─────────────────────────────────────────────────────────────

model Client {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  // Moving to encrypted columns, expand-only (src/lib/sensitive-fields.ts): new
  // writes go to *Ciphertext, reads take either. Read through the helpers.
  idNumber      String?      // ת.ז; older rows only
  idNumberCiphertext String? @db.Text
  email         String?
  phone         String?
  dateOfBirth   DateTime?
  address       String?

  intakeDate    DateTime?
  status        ClientStatus @default(ACTIVE)
  defaultRate   Decimal?     @db.Decimal(10, 2)
  generalNotes  String?      @db.Text // older rows only
  generalNotesCiphertext String? @db.Text
  treatmentType String       @default("טיפול פרטני") // label from the user-defined MeetingType list

  // Recycle bin (סל מחזור): set when the practitioner deletes the client. The
  // client is then hidden everywhere (lib/db.ts filters every read) and purged
  // for good — with all meetings, notes, files and reminder jobs — once
  // TRASH_DAYS have passed (lib/client-trash.ts). null = not deleted.
  deletedAt     DateTime?

  sessions      Session[]
  sessionNotes  SessionNote[]
  sessionFiles  SessionFile[]
  documents     ClientDocument[]
  invoices      Invoice[]
  morningDocuments MorningDocument[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, lastName])
  @@index([userId, status])
  @@index([deletedAt])
}

// Waiting list ("רשימת המתנה" tab on the clients page): people who asked for
// therapy and are waiting for a slot — not clients yet. "הפיכה ללקוח" opens
// the new-client form prefilled; the entry is deleted in the same transaction
// that creates the client. Notes are encrypted (packed AES-256-GCM,
// encryptSecret) since they may hold the reason for the referral.
model WaitlistEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  phone           String?
  notesCiphertext String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

// User-defined meeting types (סוגי מפגשים) managed in Settings
model MeetingType {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)
  color    String?  // hex color shown on calendar events of this type

  @@unique([userId, name])
}

// One row per received payment callback — bookkeeping only. status:
// VERIFIED (extended) | UNVERIFIED (needs a manual look) | DUPLICATE.
// Not unique by transactionId any more: idempotency is the GrowCheckout's
// PENDING → APPLIED switch, so a forged early callback (recorded UNVERIFIED)
// can never block the real one.
model BillingEvent {
  id            String   @id @default(cuid())
  provider      String   @default("grow")
  transactionId String
  userId        String?
  plan          String?
  amount        Float?
  status        String   @default("VERIFIED")
  raw           String?  // original callback payload (JSON string)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([transactionId])
}

// A Grow payment page we created (startCardPaymentAction). The callback is
// matched to it by processId, and the user, plan and amount come from here —
// never from the unsigned callback payload. Applied exactly once.
model GrowCheckout {
  id            String    @id @default(cuid())
  userId        String
  plan          String    // MONTHLY | YEARLY
  sum           Float     // what we asked Grow to charge (PRICING), ILS
  processId     String    @unique
  processToken  String?
  status        String    @default("PENDING") // PENDING | APPLIED
  transactionId String?
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?

  @@index([userId, createdAt(sort: Desc)])
}

// Access log for clinical content (viewing/saving/deleting note records).
// Deliberately no FK relations: audit entries must survive deletion of the
// things they describe.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // NOTE_VIEW | RECORD_VIEW | NOTE_SAVE | NOTE_DELETE | NOTE_APPEND | SESSIONS_BULK_DELETE | CLIENT_TRASH | CLIENT_RESTORE | CLIENT_PURGE | ...
  sessionId String?
  clientId  String?
  // The client document (ClientDocument) the entry is about, if any
  documentId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// One status (פעיל / לא פעיל). "ARCHIVED" was merged into INACTIVE on
// 2026-09-28 — it only hid clients from lists, same as inactive.
enum ClientStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────────────────────────
// Sessions (calendar events)
// ─────────────────────────────────────────────────────────────

model Session {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  startsAt      DateTime
  endsAt        DateTime
  status        SessionStatus @default(SCHEDULED)
  rate          Decimal?      @db.Decimal(10, 2)  // snapshot at booking time
  location      SessionLocation @default(OFFICE)
  meetingUrl    String?
  treatmentType String          @default("טיפול פרטני")

  // Numbers of documents issued outside the app (morning until 2026-11-08,
  // any system since), typed by the practitioner or written when a document
  // got its number. Names kept from the morning era. Tax invoice and receipt are separate because
  // she sometimes issues the invoice first and the receipt later.
  morningDocNumber     String?  // חשבונית מס
  morningDocUrl        String?
  morningReceiptNumber String?  // קבלה
  morningReceiptUrl    String?
  morningInvoiceReceiptNumber String?  // חשבונית מס-קבלה (מסמך משולב)
  morningInvoiceReceiptUrl    String?

  // Quick per-meeting payment record (documents issued elsewhere, no app invoice)
  paymentStatus  String?         // PAID | UNPAID | EXEMPT (ללא תשלום)
  paymentMethod  PaymentMethod?
  paidAmount     Decimal?        @db.Decimal(10, 2)
  paymentNote    String?

  // Recurrence (simple — one parent + generated children, or use rrule string)
  recurrenceRule String?      // RFC 5545 RRULE if recurring
  parentSessionId String?
  parentSession  Session?     @relation("Recurrence", fields: [parentSessionId], references: [id])
  childSessions  Session[]    @relation("Recurrence")

  note          SessionNote?
  invoiceItem   InvoiceItem?
  files         SessionFile[]

  reminderJobs  ReminderJob[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionLocation {
  OFFICE
  ONLINE
  HOME_VISIT
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Clinical notes — kept in a separate table so you can apply
// stricter access control / encryption later.
// ─────────────────────────────────────────────────────────────

model SessionNote {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Encrypt at the application layer (e.g., AES-256-GCM with a key from env / KMS).
  // The DB only ever sees ciphertext + iv + tag.
  contentCiphertext String  @db.Text
  contentIv         String
  contentTag        String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, createdAt])
}

// Documents attached to a meeting — encrypted at the app layer like notes.
// Stored in Postgres (no persistent disk on the host); capped per file.
model SessionFile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fileName       String   // older rows only ("" once encrypted; sensitive-fields.ts)
  fileNameCiphertext String?
  mimeType       String
  size           Int
  dataCiphertext Bytes
  dataIv         String
  dataTag        String

  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@index([clientId, createdAt])
}

// Documents uploaded to a client's file ("מסמכים" on the client card):
// referral letters, assessments, consent and insurance forms. Clinical data,
// so like notes: the file name and description are encrypted (packed
// AES-256-GCM, encryptSecret) and the bytes live encrypted in a separate
// table (ClientDocumentBlob), so listing a client's documents never loads
// them. Rules: src/lib/client-documents.ts; storage: src/lib/document-storage.ts.
model ClientDocument {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  nameCiphertext        String   // file name, packed AES-256-GCM
  descriptionCiphertext String?  // optional short description, packed AES-256-GCM
  category              String?  // REFERRAL | ASSESSMENT | CONSENT | INSURANCE | OTHER (null = none)
  mimeType              String   // from the file's bytes, never the browser's claim
  size                  Int      // plaintext bytes

  blob                  ClientDocumentBlob?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, clientId, createdAt])
}

// The encrypted bytes of a ClientDocument (Postgres store of
// document-storage.ts). Deleted with its document (and so with the client).
model ClientDocumentBlob {
  documentId String         @id
  document   ClientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ciphertext Bytes
  iv         String
  tag        String
}

// An expense document she uploaded (src/lib/expenses.ts). DRAFT until she
// approves it; the details are hers to type, nothing reads the file. Business
// records, not clinical.
model Expense {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         String   @default("DRAFT") // DRAFT | APPROVED
  docType        Int?     // EXPENSE_DOC_TYPES (morning's codes)
  docDate        DateTime?
  supplier       String?
  docNumber      String?
  amount         Decimal? @db.Decimal(10, 2)
  vatAmount      Decimal? @db.Decimal(10, 2) // the VAT inside `amount`

  nameCiphertext String   // file name, packed AES-256-GCM
  mimeType       String   // from the file's bytes, never the browser's claim
  size           Int      // plaintext bytes

  blob           ExpenseBlob?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status, docDate])
}

// The encrypted bytes of an Expense's file (expense-storage.ts)
model ExpenseBlob {
  expenseId  String  @id
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  ciphertext Bytes
  iv         String
  tag        String
}

// ─────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null = "לקוח מזדמן": a one-off client, known only by docClientName below.
  // No Client row is created for them.
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  number        Int           // sequential per user
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)

  subtotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  notes         String?       @db.Text
  pdfUrl        String?       // generated PDF location

  // The issued document's id/link from morning (until 2026-11-08, kept as
  // history) and its number: morning's, or the one recorded by hand for a
  // document issued elsewhere. A number = issued (counts as money).
  morningDocId     String?
  morningDocUrl    String?
  morningDocNumber String?

  // "מסמך חדש" (src/lib/billing-docs.ts): the document this row is — 305
  // חשבונית מס, 320 חשבונית מס/קבלה, 400 קבלה, 330 חשבונית זיכוי. null = an
  // older app invoice (a payment request). The app doesn't issue tax
  // documents itself (yet): until it has a number (morningDocId/Number above)
  // the row is a draft, not a tax document.
  docType          Int?
  // Line prices include VAT (true) or VAT is added on top (false); only
  // matters for a VAT-liable business (עוסק מורשה)
  vatIncluded      Boolean   @default(true)
  // Client details as printed on the document (prefilled from the client)
  docClientName    String?
  docClientTaxId   String?
  // Where the issued document is to be emailed (comma-separated)
  docClientEmail   String?
  // "תיאור תכולת המסמך" (shown on receipts, which have no item lines)
  description      String?
  // ISO code. Reports count ILS documents only: no exchange rate is stored.
  currency         String    @default("ILS")
  // Per-document settings: "he" | "en"; 0 by business type, 1 exempt
  lang             String    @default("he")
  vatType          Int       @default(0)
  rounding         Boolean   @default(false)
  // Meetings ticked on an unissued document. Internal, never printed. They
  // become links (linkOnly items + the number on the meeting) only when the
  // document is issued, so a failed issue leaves nothing behind.
  draftSessionIds  String[]  @default([])
  // The document this one refers to (same user): for a credit note (330) the
  // invoice it cancels, for a receipt (400) the tax invoice (305) it pays
  relatedInvoiceId String?
  // When issuing through morning was claimed (until 2026-11-08); history only
  morningIssuedAt  DateTime?

  items         InvoiceItem[]
  payments      Payment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, number])
  @@index([userId, issueDate])
  @@index([clientId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model InvoiceItem {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // If this line item bills a session, link it (one item per session max)
  sessionId     String?   @unique
  session       Session?  @relation(fields: [sessionId], references: [id])
  // Only ties a meeting to the document: never printed, not a line of it
  linkOnly      Boolean   @default(false)

  description   String
  quantity      Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal   @db.Decimal(10, 2)
  amount        Decimal   @db.Decimal(10, 2)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  reference     String?       // tx id, check #, last 4 digits, etc.
  notes         String?

  // Receipt-line details per payment type
  bankName      String?       // transfer / cheque
  bankBranch    String?
  bankAccount   String?
  chequeNumber  String?
  cardType      String?       // VISA | MASTERCARD | ISRACARD | AMEX | DINERS
  cardLast4     String?
  dealType      String?       // REGULAR | INSTALLMENTS | CREDIT
  installments  Int?

  // For online providers
  provider      String?       // "tranzila" | "cardcom" | "paypal" | null
  providerTxId  String?

  createdAt     DateTime      @default(now())

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BIT
  PAYBOX
  CHECK
  BANK_TRANSFER
  CREDIT_CARD
  PAYPAL
  OTHER
  PAYONEER
  GOOGLE_PAY
  APPLE_PAY
  GIFT_VOUCHER
}

// ─────────────────────────────────────────────────────────────
// Reminders (queued jobs to send email/SMS before a session)
// ─────────────────────────────────────────────────────────────

// Personal task list shown on the dashboard
model Todo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, done])
}

// Messages sent to the inbound API (iOS Shortcut / automations) awaiting
// processing on the import page.
model InboxMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.Text // older rows only ("" once encrypted; sensitive-fields.ts)
  textCiphertext String? @db.Text
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, processed])
}

// Documents issued directly in morning, imported before the integration was
// removed (2026-11-08). Nothing new arrives; existing rows are history and can
// still be assigned to a client.
model MorningDocument {
  // Our row id. Rows synced before 2026-10-29 kept morning's id here (the
  // migration copied it into morningId); new rows get a cuid.
  id                String    @id @default(cuid())
  /// morning's document id — unique per account, not globally: two practices
  /// may sync the same morning document without touching each other's row
  morningId         String
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  number            String?
  docType           Int?
  docDate           DateTime?
  amount            Decimal?  @db.Decimal(10, 2)
  description       String?
  morningClientName String?
  url               String?

  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt         DateTime  @default(now())

  @@unique([userId, morningId])
  @@index([userId, clientId])
}

model ReminderJob {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  channel       ReminderChannel
  scheduledFor  DateTime
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  error         String?
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([status, scheduledFor])
}

enum ReminderChannel {
  EMAIL
  SMS
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// "פנייה לתמיכה" from the in-app help widget (src/server/actions/support.ts).
// Saved first, then emailed to SUPPORT_EMAIL — a request is never lost when the
// email fails (emailStatus FAILED is retried by the hourly maintenance). The
// optional screenshot is stored encrypted like session files. The text is what
// the user typed; the form asks not to include client-identifying details and
// nothing clinical is ever attached automatically.
model SupportRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  email     String
  phone     String?
  subject   String
  message   String
  // Page the widget was opened on, with record ids replaced (sanitizePagePath)
  pagePath  String?
  userAgent String?

  attachmentName       String?
  attachmentType       String?
  attachmentSize       Int?
  attachmentCiphertext Bytes?
  attachmentIv         String?
  attachmentTag        String?

  emailStatus   String    @default("PENDING") // PENDING | SENT | FAILED
  emailError    String?
  emailAttempts Int       @default(0)
  emailedAt     DateTime?

  status    String   @default("OPEN") // OPEN | DONE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([emailStatus, createdAt])
  @@index([createdAt])
}

// Rate-limit counters and login-failure counts (src/lib/rate-limit.ts). The key
// is an HMAC, so the table holds no email or IP address. Expired rows are
// deleted by the hourly maintenance.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  lastHitAt DateTime

  @@index([expiresAt])
}

// Invitation links (src/lib/invite-codes.ts), created in Settings by an admin.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  // Who it is for: the admin's own note, shown only in the admin card
  note        String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  // Not a relation, like AuditLog: a code outlives anything done to the account
  createdById String
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}
