# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/psy_app"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-random-32-bytes"

# Fine for local dev. In PRODUCTION leave NEXTAUTH_URL/AUTH_URL unset — they pin
# every request to one origin and break the second address. Set APP_URL (the
# main public address, used in emailed links) and optionally APP_ALT_ORIGINS
# (comma-separated extra https origins the app is also served on, e.g. the old
# Railway address). See src/lib/request-origin.ts.
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
# APP_URL="https://mirpaa.app"
# APP_ALT_ORIGINS=""

# ── Sign-up (src/lib/signup-policy.ts) ─────────────────────────────
# By invitation: a NEW account (email/password or Google) can be created only
# for these comma-separated emails. Existing users always sign in. If unset,
# sign-up is closed in production (open in dev).
# Example: ALLOWED_EMAILS="you@example.com"
ALLOWED_EMAILS=""
# Set to "true" to open sign-up to everyone (the allowlist no longer matters,
# /register shows the form, /pricing says "התחלת 30 יום חינם"). Not a secret.
# SIGNUP_OPEN="true"

# ── Sign in with Google (optional) ─────────────────────────────────
# OAuth "Web application" client from Google Cloud Console. The "המשך עם Google"
# buttons appear only when BOTH are set. Redirect URI to register:
#   <origin>/api/auth/callback/google   for EVERY address the app is served on
#   (https:// in production), and each origin as a JavaScript origin. Google
#   sign-up follows the same rule as email sign-up (ALLOWED_EMAILS / SIGNUP_OPEN).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Session notes encryption key — MUST be 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
NOTES_ENCRYPTION_KEY="replace-me-with-32-random-bytes-base64"

# ── Reminders (email) ──────────────────────────────────────────────
# Resend API key — sign up at https://resend.com (free tier is generous)
# Without this, reminder jobs will be marked FAILED but the app keeps working.
RESEND_API_KEY=""

# The "From" address used for reminder emails. The domain must be verified in
# Resend. For local dev, you can use Resend's test address: onboarding@resend.dev
EMAIL_FROM="מרפאה <reminders@yourdomain.com>"

# ── Cron auth ──────────────────────────────────────────────────────
# Used to authenticate Vercel Cron calls to /api/cron/reminders.
# Generate with: openssl rand -base64 32
# In dev without this set, the endpoint is open. In production it is required.
CRON_SECRET=""

# Grow (Meshulam) card payments — optional; without these the app uses the
# manual-payment flow. Get from the Grow business account.
GROW_USER_ID=
GROW_PAGE_CODE=
# Sandbox testing: https://sandbox.meshulam.co.il (default is production)
# GROW_BASE_URL=
